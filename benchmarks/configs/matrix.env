# Existing environment variables take precedence over these defaults.
: "${WORKLOADS:=zipf cost_inversion variable_size scan hotset_shift burst regional_split mixed}"
: "${SEEDS:=1 2 3 4 5}"
: "${REQUESTS:=10000000}"
: "${KEYS:=1000000}"
: "${VARIABLE_SIZE_KEYS:=200000}"
: "${CAPACITY_FRACTIONS:=0.001,0.005,0.01,0.02,0.05,0.1,0.2}"
: "${WARMUP_FRACTION:=0.2}"
: "${POLICIES:=lru,lfu,lfu_da,gds,gdsf,gdsf_window,wtinylfu,s3fifo,redis_lru,redis_lfu,clache,clache_decay,clache_noghost,clache_nocost,clache_nosize,clache_noadmit}"
